{
  "name": "bun-migrate",
  "version": "1.0.0",
  "description": "Automated migration tool from npm to Bun - Migrate any Node.js project to use Bun as package manager with 10-20x faster dependency installation",
  "type": "module",
  "bin": {
    "bun-migrate": "./cli.js"
  },
  "scripts": {
    "test": "node cli.js --help",
    "start": "node cli.js",
    "link": "npm link",
    "publish:dry": "npm publish --dry-run",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "bun",
    "migration",
    "npm",
    "package-manager",
    "nextjs",
    "react",
    "docker",
    "nixpacks",
    "cli",
    "automation",
    "build-tools"
  ],
  "author": "Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/bun-migrate.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/bun-migrate/issues"
  },
  "homepage": "https://github.com/yourusername/bun-migrate#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.5"
  },
  "files": [
    "cli.js",
    "README.md",
    "LICENSE"
  ]
}
