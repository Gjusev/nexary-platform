# =============================================================================
# ProjectNexus - Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (REQUIRED)
# -----------------------------------------------------------------------------
POSTGRES_URL="postgresql://user:password@localhost:5432/projectnexus"

# -----------------------------------------------------------------------------
# Authentication - Stack Auth (Primary)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="your-stack-publishable-key"
STACK_SECRET_SERVER_KEY="your-stack-secret-key"
STACK_INTERNAL_API_URL="https://api.stack-auth.com"
STACK_AUTH_CALLBACK_URL="http://localhost:3000/api/auth/callback/stack"

# Legacy Stack Auth (deprecated, use above instead)
STACK_AUTH_API_URL="https://api.stack-auth.com"
STACK_AUTH_PROJECT_ID="your-stack-project-id"
STACK_AUTH_API_KEY="stack-auth-service-api-key"

# -----------------------------------------------------------------------------
# Authentication - NextAuth (Legacy)
# -----------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="set-a-strong-random-secret"

# -----------------------------------------------------------------------------
# Authentication - Keycloak (Legacy/Alternative)
# -----------------------------------------------------------------------------
KEYCLOAK_URL="https://auth.example.com"
KEYCLOAK_REALM="nexus"
KEYCLOAK_ADMIN_CLIENT_ID="nexus-admin"
KEYCLOAK_ADMIN_SECRET="admin-secret"

# -----------------------------------------------------------------------------
# RAG System - Qdrant Vector Database (REQUIRED for RAG)
# -----------------------------------------------------------------------------
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_VECTOR_SIZE=3072
QDRANT_DISTANCE="Cosine"

# -----------------------------------------------------------------------------
# RAG System - OpenAI Embeddings (REQUIRED for RAG)
# -----------------------------------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# -----------------------------------------------------------------------------
# RAG System - MinIO Object Storage (OPTIONAL)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_USE_SSL=false
MINIO_BUCKET="projectnexus"

# -----------------------------------------------------------------------------
# RAG System - Text Extraction Service (OPTIONAL)
# -----------------------------------------------------------------------------
# TEXT_EXTRACTOR_URL="http://localhost:8080/extract"

# -----------------------------------------------------------------------------
# RAG System - Mistral OCR Service (OPTIONAL)
# -----------------------------------------------------------------------------
MISTRAL_OCR_ENDPOINT="https://api.mistral.ai/v1/ocr"
MISTRAL_OCR_API_KEY="your-mistral-api-key-here"

# -----------------------------------------------------------------------------
# OCR Microservice Configuration
# -----------------------------------------------------------------------------
OCR_MICROSERVICE_URL="https://ocr.example.com/ocr/upload"
APP_API_KEY="your-app-api-key-here"

# -----------------------------------------------------------------------------
# Caching - Redis (OPTIONAL but RECOMMENDED)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AI Providers - Additional Models (OPTIONAL)
# -----------------------------------------------------------------------------
GOOGLE_API_KEY="your-google-gemini-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
#NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Security & CORS
# -----------------------------------------------------------------------------
# CORS_ORIGIN - Comma-separated list of allowed origins for API
# CORS_ORIGIN="http://localhost:3000,https://yourdomain.com"

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# ANALYZE - Enable bundle analyzer during build (set to 'true' to analyze)
# ANALYZE="true"

# =============================================================================
# Monitoring and Observability
# =============================================================================

# -----------------------------------------------------------------------------
# Sentry - Error Tracking & Performance Monitoring
# -----------------------------------------------------------------------------
# Get your DSN from https://sentry.io/
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ENVIRONMENT="production"
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
SENTRY_REPLAY_SESSION_SAMPLE_RATE="0.1"
SENTRY_REPLAY_ERROR_SAMPLE_RATE="1.0"

# Public Sentry Configuration (client-side)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE="1.0"

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: debug, info, warn, error, fatal
LOG_LEVEL="info"

# Enable/disable telemetry collection
ENABLE_TELEMETRY="true"

# -----------------------------------------------------------------------------
# Datadog - APM and Metrics (Optional)
# -----------------------------------------------------------------------------
# Get your keys from https://www.datadoghq.com/
DATADOG_API_KEY="your-datadog-api-key"
DATADOG_APP_KEY="your-datadog-app-key"
DATADOG_SITE="datadoghq.com"

# -----------------------------------------------------------------------------
# Alert Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable email alerts
ALERT_EMAIL_ENABLED="true"
ALERT_EMAIL_TO="alerts@example.com"

# Slack webhook for alerts
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# -----------------------------------------------------------------------------
# Maintenance Mode
# -----------------------------------------------------------------------------
# Set to 'true' during maintenance to silence non-critical alerts
MAINTENANCE_MODE="false"

# =============================================================================
# OIDC (OpenID Connect) Enterprise SSO - Authentik Integration
# =============================================================================

# -----------------------------------------------------------------------------
# Authentik Configuration
# -----------------------------------------------------------------------------
# Authentik issuer URL for your application
AUTHENTIK_ISSUER="https://authentik.example.com/application/o/nexary-enterprise/"

# OAuth2/OIDC client credentials from Authentik
AUTHENTIK_CLIENT_ID="your-client-id"
AUTHENTIK_CLIENT_SECRET="your-client-secret"

# -----------------------------------------------------------------------------
# OIDC Redirect URIs
# -----------------------------------------------------------------------------
# Callback URL for development (must match Authentik configuration)
AUTHENTIK_REDIRECT_URI="http://localhost:3000/api/oidc/callback"

# Callback URL for production (must match Authentik configuration)
AUTHENTIK_REDIRECT_URI_PROD="https://your-deployment.example.com/api/oidc/callback"

# -----------------------------------------------------------------------------
# Feature Flags - OIDC Rollout
# -----------------------------------------------------------------------------
# Enable/disable OIDC authentication globally
FEATURE_FLAG_OIDC_ENABLED="false"

# Percentage of teams that can use OIDC (0-100)
# Set to 100 to enable for all teams, 0 to disable
FEATURE_FLAG_OIDC_CANARY_PERCENT="0"

# Enable SAML to OIDC migration
FEATURE_FLAG_OIDC_MIGRATION_ENABLED="false"
